<?xml version="1.0" encoding="UTF-8"?>
<web-app>
    <context-param>
        <param-name>collegeName</param-name>
        <param-value>ABC Engineering College</param-value>
    </context-param>
    <servlet>
        <servlet-name>ParamServlet</servlet-name>
        <servlet-class>ParamServlet</servlet-class>
        <init-param>
            <param-name>department</param-name>
            <param-value>CSE</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>ParamServlet</servlet-name>
        <url-pattern>/params</url-pattern>
    </servlet-mapping>

</web-app>
